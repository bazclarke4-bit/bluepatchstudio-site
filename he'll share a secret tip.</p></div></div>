<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Blue Patch Studio: fun little games</title>
<meta name="description" content="Blue Patch Studio makes friendly mobile games hosted by Blu the bulldog and Patch the cat.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%90%BE%3C/text%3E%3C/svg%3E">
<style>
  :root {
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    --bg: #e9eef3; --panel: #ffffff; --ink: #1f2a37; --muted: #5b6878;
    --slate: #4a6078; --slate-dark: #2f3f52; --blue: #3d7cc9; --line: #d3dce6;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --bg: #161c24; --panel: #1f2731; --ink: #e8eef5; --muted: #a7b3c2; --line: #33404f; }
  }
  :root[data-theme="dark"] { --bg: #161c24; --panel: #1f2731; --ink: #e8eef5; --muted: #a7b3c2; --line: #33404f; }
  * { box-sizing: border-box; }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: "Trebuchet MS", "Segoe UI", system-ui, sans-serif; line-height: 1.6; }
  a { color: var(--blue); }
  header.top { background: linear-gradient(135deg, var(--slate-dark), var(--slate)); color: #fff; }
  header.top .in { max-width: 920px; margin: 0 auto; padding: 14px 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .brand { font: 900 22px Georgia, "Times New Roman", serif; color: #fff; text-decoration: none; letter-spacing: .3px; }
  .brand span { color: #9cc4f0; }
  nav a { color: #dbe7f3; text-decoration: none; margin-left: 16px; font-weight: 700; font-size: 15px; }
  nav a:hover, nav a:focus-visible { color: #fff; text-decoration: underline; }
  main { max-width: 920px; margin: 0 auto; padding: 24px 20px 40px; }
  footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
  footer .in { max-width: 920px; margin: 0 auto; padding: 18px 20px; display: flex; gap: 16px; flex-wrap: wrap; justify-content: space-between; }
  .doc { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 24px 22px; }
  .doc h1 { font: 900 32px/1.15 Georgia, serif; margin: 0 0 4px; }
  .doc h2 { font: 800 20px Georgia, serif; margin: 26px 0 6px; }
  .doc .date { color: var(--muted); margin: 0 0 18px; }
  .doc ul { padding-left: 22px; }
  .note { background: rgba(61,124,201,.1); border-left: 4px solid var(--blue); padding: 10px 14px; border-radius: 8px; }

  .hero { background: linear-gradient(160deg, #5d7590 0%, #3e5670 60%, #2f3f52 100%); color: #fff; border-radius: 22px; padding: 30px 24px 0; display: grid; grid-template-columns: 1.2fr 1fr; gap: 10px; align-items: end; overflow: hidden; }
  .hero h1 { font: 900 clamp(32px, 6vw, 50px)/1.05 Georgia, serif; margin: 0 0 10px; }
  .hero p { font-size: 18px; color: #e3ecf5; margin: 0 0 18px; max-width: 30ch; }
  .hero .copy { padding-bottom: 30px; }
  .pals { display: flex; justify-content: center; align-items: flex-end; gap: 0; }
  .pals img { width: 48%; max-width: 170px; height: auto; filter: drop-shadow(0 6px 4px rgba(0,0,0,.3)); }
  .pals img + img { margin-left: -12px; }
  .pill { display: inline-block; background: #9cc4f0; color: #1f2a37; font-weight: 800; padding: 10px 18px; border-radius: 999px; text-decoration: none; }
  h2.sec { font: 900 26px Georgia, serif; margin: 34px 0 12px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 20px; }
  .card h3 { font: 800 20px Georgia, serif; margin: 6px 0; }
  .card .tag { font-size: 12px; font-weight: 800; letter-spacing: .6px; text-transform: uppercase; color: var(--slate); }
  .card p { color: var(--muted); margin: 6px 0 0; }
  .meet { display: grid; grid-template-columns: 90px 1fr; gap: 14px; align-items: center; }
  .meet img { width: 90px; height: auto; }
  @media (max-width: 640px) { .hero { grid-template-columns: 1fr; text-align: center; } .hero p { margin-left: auto; margin-right: auto; } .hero .copy { padding-bottom: 6px; } }

</style>
</head>
